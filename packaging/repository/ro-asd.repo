[ro-asd-beta]
name=Ro-ASD Fedora 44 Beta - $basearch
baseurl=https://repo.ro-asd.org/rpm/fedora/44/beta/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/REPODATA-GPG-KEY-ro-asd
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ro-asd
metadata_expire=300
skip_if_unavailable=0

[ro-asd-beta-source]
name=Ro-ASD Fedora 44 Beta - Source
baseurl=https://repo.ro-asd.org/rpm/fedora/44/beta/source/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/REPODATA-GPG-KEY-ro-asd
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ro-asd
metadata_expire=300
skip_if_unavailable=0

[ro-asd-stable]
name=Ro-ASD Fedora 44 Stable - $basearch
baseurl=https://repo.ro-asd.org/rpm/fedora/44/stable/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/REPODATA-GPG-KEY-ro-asd
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ro-asd
metadata_expire=300
skip_if_unavailable=0
